---
export const prerender = true;

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const tips = await getCollection('tips');
  return tips.map((tip) => ({
    params: { slug: tip.id },
    props: { tip },
  }));
}

const { tip } = Astro.props;
const { Content } = await render(tip);
---

<BaseLayout title={`${tip.data.title} | 業務効率化メモ`}>
	<header class="page-header">
		<a href="/">← トップに戻る</a>
		<h1 style="margin-top: 0.75rem;">{tip.data.title}</h1>
		<div class="card-meta" style="max-width: none;">
			<span class="card-category">{tip.data.category}</span>
			<time datetime={tip.data.publishedAt}>{tip.data.publishedAt}</time>
		</div>
	</header>
	<main>
		<article class="tip-body">
			<Content />
		</article>
	</main>
	<footer class="site-footer">
		<p>この記事はAIが作成しています。内容の正確性には配慮していますが、最新情報は各サービスの公式情報もあわせてご確認ください。</p>
	</footer>
</BaseLayout>
