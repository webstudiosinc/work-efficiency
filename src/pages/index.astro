---
export const prerender = true;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const tips = (await getCollection('tips')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);
---

<BaseLayout title="業務効率化メモ">
	<header class="page-header">
		<h1>業務効率化メモ</h1>
		<p class="site-description">
			ITツールに詳しくない方や中小企業にお勤めの方に向けて、すぐ使えるショートカットや業務効率化の情報をまとめています。
		</p>
		<p style="margin-top: 0.75rem;">
			<a href="/news/">→ 会計・勤怠・請求書などの最新ニュースはこちら</a>
		</p>
	</header>

	<main>
		<h2 class="section-title">使い方Tips</h2>
		<ul class="card-list">
			{
				tips.map((tip) => (
					<li class="card">
						<span class="card-category">{tip.data.category}</span>
						<h3 class="card-title">
							<a href={`/tips/${tip.id}/`}>{tip.data.title}</a>
						</h3>
						<p class="card-excerpt">{tip.data.description}</p>
						<div class="card-meta">
							<span>当サイト作成</span>
							<time datetime={tip.data.publishedAt}>{tip.data.publishedAt}</time>
						</div>
						<a class="card-link" href={`/tips/${tip.id}/`}>
							続きを読む →
						</a>
					</li>
				))
			}
		</ul>
	</main>

	<footer class="site-footer">
		<p>「使い方Tips」はAIが作成した解説記事です。</p>
	</footer>
</BaseLayout>
