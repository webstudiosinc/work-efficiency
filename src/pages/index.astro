---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { posts } from '../data/posts';

const tips = (await getCollection('tips')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const sortedPosts = [...posts].sort(
  (a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime()
);
---

<BaseLayout title="業務効率化メモ">
	<header class="page-header">
		<h1>業務効率化メモ</h1>
		<p class="site-description">
			ITツールに詳しくない方や中小企業にお勤めの方に向けて、すぐ使えるショートカットや業務効率化の情報をまとめています。
		</p>
	</header>

	<main>
		<h2 class="section-title">使い方Tips</h2>
		<ul class="card-list">
			{
				tips.map((tip) => (
					<li class="card">
						<span class="card-category">{tip.data.category}</span>
						<h3 class="card-title">
							<a href={`/tips/${tip.id}/`}>{tip.data.title}</a>
						</h3>
						<p class="card-excerpt">{tip.data.description}</p>
						<div class="card-meta">
							<span>当サイト作成</span>
							<time datetime={tip.data.publishedAt}>{tip.data.publishedAt}</time>
						</div>
						<a class="card-link" href={`/tips/${tip.id}/`}>
							続きを読む →
						</a>
					</li>
				))
			}
		</ul>

		<h2 class="section-title">ニュース（準備中）</h2>
		<p class="notice-box">
			会計・勤怠・請求書・AIツールなどの最新情報を自動収集して掲載する予定です（現在はサンプルデータを表示しています）。
		</p>
		<ul class="card-list">
			{
				sortedPosts.map((post) => (
					<li class="card">
						<span class="card-category">{post.category}</span>
						<h3 class="card-title">{post.title}</h3>
						<p class="card-excerpt">{post.excerpt}</p>
						<div class="card-meta">
							<span>{post.sourceName}</span>
							<time datetime={post.publishedAt}>{post.publishedAt}</time>
						</div>
						<a class="card-link" href={post.sourceUrl} target="_blank" rel="noopener noreferrer">
							元記事を読む →
						</a>
					</li>
				))
			}
		</ul>
	</main>

	<footer class="site-footer">
		<p>
			「使い方Tips」はAIが作成した解説記事、「ニュース」は自動収集です（現在は準備中のためサンプル表示）。詳細は元記事をご確認ください。
		</p>
	</footer>
</BaseLayout>
