{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "work-efficiency-rss-collector",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "NEWS_KV",
      "id": "8d54797b3bbd424d90b81d35792d4dfc"
    }
  ],
  "triggers": {
    "crons": ["0 0,6,12 * * *"]
  }
}
